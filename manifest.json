{
  "manifest_version": 3,
  "name": "CheatCode - Striver Sheet LeetCode & GFG Restorer",
  "short_name": "CheatCode",
  "version": "2.1.0",
  "description": "Restores direct LeetCode and GeeksforGeeks links beside every problem on Striver's A2Z DSA Sheet (takeuforward.org). Built by brindoxx.",
  "author": "brindoxx",
  "homepage_url": "https://github.com/brindoxx/CheatCode",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://takeuforward.org/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://takeuforward.org/*"
      ],
      "js": [
        "scripts/matcher.js",
        "scripts/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/problems.json",
        "icons/*"
      ],
      "matches": [
        "*://takeuforward.org/*"
      ]
    }
  ]
}
